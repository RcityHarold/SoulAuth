# SoulAuth 配置示例
#
# 复制为 .env 后按需修改。**必填只有四项**（缺任一进程起不来）：
# JWT_SECRET / APP_URL / SMTP_HOST / SMTP_FROM。
# 其余全部有默认值，完整说明见 DEPLOYMENT.md。

# ── 必填 ────────────────────────────────────────────────────────────
# 至少 32 个字符。生成：openssl rand -hex 32
JWT_SECRET=

# **公开**地址，不是监听地址（监听地址是 BIND_ADDR）。
# 它决定 OIDC issuer、外发邮件里链接的前缀，以及会话 cookie 是否带 Secure。
# 指向非环回地址会打开生产闸门：OIDC 私钥与 MFA 密钥变成必填。
APP_URL=http://localhost:8080

SMTP_HOST=127.0.0.1
SMTP_FROM=noreply@localhost

# ── 服务 ────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
# 会话与访问令牌有效期（秒）
JWT_EXPIRATION=86400
PASSWORD_MIN_LENGTH=12
# 已认证请求的会话校验缓存（秒）。0 = 每个请求都回库校验
AUTH_SESSION_CACHE_TTL_SECONDS=5
# 逗号分隔。留空则只允许 APP_URL 自身
CORS_ALLOWED_ORIGINS=

# ── 账号锁定（暴力破解防护）──────────────────────────────────────────
# 连续失败多少次后锁定（必须 ≥1）
LOCKOUT_MAX_ATTEMPTS=5
# 锁定持续多少分钟（必须 ≥1）
LOCKOUT_DURATION_MINUTES=15
# 多久没有新的失败尝试就把计数清零
LOCKOUT_RESET_WINDOW_MINUTES=60
# 分别控制账号维度与 IP 维度的锁定；关掉任一维度都会削弱防护
LOCKOUT_USER_ENABLED=true
LOCKOUT_IP_ENABLED=true
# 管理员可通过 POST /api/security/unlock 手工解锁（需 soulauth:security.write）

# 只有确实跑在受控反向代理之后才置 true，
# 否则任何客户端都能伪造 X-Forwarded-For 绕开限流与 IP 锁定
TRUST_PROXY_HEADERS=false

# ── 数据库 ──────────────────────────────────────────────────────────
# 带 https:// 前缀即用 TLS 连接器；明文指向非环回地址时启动会告警 ——
# 这条链路上跑的是数据库口令、密码哈希与会话令牌
DATABASE_URL=127.0.0.1:8000
DATABASE_USER=root
DATABASE_PASS=root
DATABASE_NAMESPACE=auth
DATABASE_NAME=main
DATABASE_CONNECTION_TIMEOUT=30

# ── 生产必填（APP_URL 非环回时缺任一即拒绝启动）────────────────────
# ID Token 的 RS256 私钥。不配置则每次重启换一把新的，
# 已签发的 ID Token 全部无法验证，多副本之间也互不认账。
# 生成：openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
OIDC_RSA_PRIVATE_KEY_PATH=
# 或直接内联 PEM（\n 会被还原成换行）
OIDC_RSA_PRIVATE_KEY_PEM=

# MFA TOTP 密钥的加密密钥。不配置则从 JWT_SECRET 派生，
# 那样轮换 JWT_SECRET 会让所有已存的 TOTP 密钥无法解密。
# 生成：openssl rand -base64 32
MFA_SECRET_ENCRYPTION_KEY=

# ── 邮件 ────────────────────────────────────────────────────────────
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# true 走明文 SMTP，仅用于本地 sink
SMTP_INSECURE=false
EMAIL_VERIFICATION_ENABLED=false

# ── 前端页面地址（缺省由 APP_URL 推导）──────────────────────────────
LOGIN_PAGE_URL=
VERIFY_EMAIL_PAGE_URL=

# ── 第三方登录（可选，两项必须成对出现）────────────────────────────
# 一个都不配也能跑，对应入口返回 501
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 配了任一 provider 就必填
OAUTH_REDIRECT_URL=
# 端点根地址覆盖：自建 GitHub Enterprise 用它；明文只允许指向环回地址
GOOGLE_OAUTH_BASE_URL=
GITHUB_OAUTH_BASE_URL=

# ── 出站代理（仅影响 OAuth 的 HTTP 请求，SMTP 走裸 TCP 不认）────────
PROXY_ENABLED=false
PROXY_URL=

# ── 日志 ────────────────────────────────────────────────────────────
RUST_LOG=soulauth=info,tower_http=warn
